{
  "name": "cb-inbound-iq",
  "version": "3.2.0",
  "private": true,
  "description": "Carrybee InboundIQ — Smart Answers for Every Delivery (Inbound Contact Center CRM on Supabase + Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:worker": "wrangler dev --ip 0.0.0.0 --port 8787",
    "build": "vite build",
    "preview": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.5",
    "@cloudflare/workers-types": "^4.20250310.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "wrangler": "^4.4.0"
  }
}
