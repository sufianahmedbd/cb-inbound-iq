{
  "manifest_version": 3,
  "name": "Carrybee InboundIQ Parcel Bridge",
  "version": "3.5.0",
  "description": "Manually transfer the currently visible Carrybee Hive order into InboundIQ in the same browser.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://*.carrybee.com/*",
    "https://*.workers.dev/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hive.carrybee.com/orders*"],
      "js": ["content-ops-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.workers.dev/*", "http://localhost:5173/*"],
      "js": ["content-crm-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
